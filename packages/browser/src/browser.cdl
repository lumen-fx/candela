/// What a browser offers a page outside its own document: popup windows and
/// the messages they send back, sharing, downloads, the leave-page prompt,
/// media queries, a file picker and fullscreen.
///
/// Every function works in a browser, through the JavaScript module this
/// package ships. Anywhere else each one raises `browser_only`, so a program
/// written for a page compiles and runs on the desktop too; code that should
/// do something else there picks a side with `@cfg(web)`.
///
/// An answer the browser gives later, a share or a picked file, arrives in the
/// function passed to the call. Messages other windows post to this one and
/// fullscreen changes arrive in the function passed to `on_message` and
/// `on_fullscreen_change`.

import "std/event";
import "std/json";

@cfg(web)
host "browser" {
    bool candela_browser_open_popup(string, string, string);
    bool candela_browser_close_popup(string);
    bool candela_browser_post_message(string, any, string);
    candela_browser_close_window();
    candela_browser_share(int, {string: any});
    bool candela_browser_can_share({string: any});
    candela_browser_download_text(string, string, string);
    candela_browser_guard_unload(bool);
    bool candela_browser_match_media(string);
    candela_browser_watch_media(int, string);
    candela_browser_pick_file(int, string);
    candela_browser_request_fullscreen(int, string);
    candela_browser_exit_fullscreen();
    bool candela_browser_is_fullscreen();
    candela_browser_on_message(int);
    candela_browser_on_fullscreen_change(int);
}

/// A file the visitor picked.
struct PickedFile {
    name: string,
    /// Its MIME type, as the browser reports it; empty when it does not know.
    mime: string,
    size: int,
    text: string,
}

/// A message another window posted to this one.
struct Message {
    /// The origin of the window that sent it.
    origin: string,
    /// What it sent, as JSON reads it.
    data: any,
    /// Who sent it: `opener`, `parent`, a popup's name, or empty for a window
    /// this page did not open.
    source: string,
}

/// The source a browser answer arrives under, with `on_done` reading it as a
/// `Result` of `T`.
fn answer_source<T>(read: fn(any) -> T, on_done: fn(Result<T, string>)) -> int {
    let id = event::source();
    event::on(id, fn(payload) {
        let fields = json::parse(payload) as {string: any};
        if fields.contains("error") {
            on_done(Err(fields["error"] as string));
        } else {
            on_done(Ok(read(fields["value"])));
        }
    });
    return id;
}

// Each function has a browser half under `@cfg(web)` and, under
// `@cfg(not(web))`, a desktop half that raises `browser_only`. A desktop half
// that declares a return type returns a value after the throw, which never
// runs; the compiler wants a value of that type on the way out.

/// Opens a popup window under `name`, with `window.open` features such as
/// `"width=500,height=600"`. False when the browser blocked it.
@cfg(web)
fn open_popup(url: string, name: string, features: string) -> bool => browser::candela_browser_open_popup(url, name, features);
@cfg(not(web))
fn open_popup(url: string, name: string, features: string) -> bool {
    throw "browser_only";
    return false;
}

/// Closes the popup opened under `name`. False when there is none.
@cfg(web)
fn close_popup(name: string) -> bool => browser::candela_browser_close_popup(name);
@cfg(not(web))
fn close_popup(name: string) -> bool {
    throw "browser_only";
    return false;
}

/// Sends `data` to `opener`, `parent` or a popup by name, for a window at
/// `origin` (`"*"` for any). False when there is no such window.
@cfg(web)
fn post_message(target: string, data: any, origin: string) -> bool => browser::candela_browser_post_message(target, data, origin);
@cfg(not(web))
fn post_message(target: string, data: any, origin: string) -> bool {
    throw "browser_only";
    return false;
}

/// Closes this window, which the browser allows for a window a script opened.
@cfg(web)
fn close_window() {
    browser::candela_browser_close_window();
}
@cfg(not(web))
fn close_window() {
    throw "browser_only";
}

/// Opens the system share sheet for a title, text and url. `on_done` receives
/// `Ok(true)` once shared, or the reason it was not.
@cfg(web)
fn share(data: {string: any}, on_done: fn(Result<bool, string>)) {
    let id = answer_source(fn(v) => v as bool, on_done);
    browser::candela_browser_share(id, data);
}
@cfg(not(web))
fn share(data: {string: any}, on_done: fn(Result<bool, string>)) {
    throw "browser_only";
}

/// True when the browser can share this title, text and url.
@cfg(web)
fn can_share(data: {string: any}) -> bool => browser::candela_browser_can_share(data);
@cfg(not(web))
fn can_share(data: {string: any}) -> bool {
    throw "browser_only";
    return false;
}

/// Saves `text` as a file through the browser's download.
@cfg(web)
fn download_text(filename: string, mime: string, text: string) {
    browser::candela_browser_download_text(filename, mime, text);
}
@cfg(not(web))
fn download_text(filename: string, mime: string, text: string) {
    throw "browser_only";
}

/// While `on`, leaving or reloading the page asks the visitor to confirm.
@cfg(web)
fn guard_unload(on: bool) {
    browser::candela_browser_guard_unload(on);
}
@cfg(not(web))
fn guard_unload(on: bool) {
    throw "browser_only";
}

/// Whether a media query matches, such as `"(prefers-color-scheme: dark)"`.
@cfg(web)
fn match_media(query: string) -> bool => browser::candela_browser_match_media(query);
@cfg(not(web))
fn match_media(query: string) -> bool {
    throw "browser_only";
    return false;
}

/// Calls `on_change` with whether `query` matches each time that changes.
@cfg(web)
fn watch_media(query: string, on_change: fn(bool)) {
    let id = event::source();
    event::on(id, fn(payload) {
        on_change((json::parse(payload) as {string: any})["matches"] as bool);
    });
    browser::candela_browser_watch_media(id, query);
}
@cfg(not(web))
fn watch_media(query: string, on_change: fn(bool)) {
    throw "browser_only";
}

/// Asks the visitor for a text file, `accept` as in `<input accept>`, and
/// passes `on_done` what they picked. Needs a click or key press just before.
@cfg(web)
fn pick_file(accept: string, on_done: fn(Result<PickedFile, string>)) {
    let read = fn(v) {
        let file = v as {string: any};
        return PickedFile {
            name: file["name"] as string,
            mime: file["type"] as string,
            size: file["size"] as int,
            text: file["text"] as string,
        };
    };
    let id = answer_source(read, on_done);
    browser::candela_browser_pick_file(id, accept);
}
@cfg(not(web))
fn pick_file(accept: string, on_done: fn(Result<PickedFile, string>)) {
    throw "browser_only";
}

/// Shows the element with this id fullscreen, or the whole page for `""`.
/// `on_done` receives `Ok(true)` once it is. Needs a click or key press just
/// before.
@cfg(web)
fn request_fullscreen(id: string, on_done: fn(Result<bool, string>)) {
    let source = answer_source(fn(v) => v as bool, on_done);
    browser::candela_browser_request_fullscreen(source, id);
}
@cfg(not(web))
fn request_fullscreen(id: string, on_done: fn(Result<bool, string>)) {
    throw "browser_only";
}

/// Leaves fullscreen.
@cfg(web)
fn exit_fullscreen() {
    browser::candela_browser_exit_fullscreen();
}
@cfg(not(web))
fn exit_fullscreen() {
    throw "browser_only";
}

/// True while something is fullscreen.
@cfg(web)
fn is_fullscreen() -> bool => browser::candela_browser_is_fullscreen();
@cfg(not(web))
fn is_fullscreen() -> bool {
    throw "browser_only";
    return false;
}

/// Calls `handler` with every message another window posts to this one.
@cfg(web)
fn on_message(handler: fn(Message)) {
    let id = event::source();
    event::on(id, fn(payload) {
        let fields = json::parse(payload) as {string: any};
        handler(Message {
            origin: fields["origin"] as string,
            data: fields["data"],
            source: fields["source"] as string,
        });
    });
    browser::candela_browser_on_message(id);
}
@cfg(not(web))
fn on_message(handler: fn(Message)) {
    throw "browser_only";
}

/// Calls `handler` with the id of the element shown fullscreen, empty for the
/// whole page, and whether fullscreen started or ended, each time it does.
@cfg(web)
fn on_fullscreen_change(handler: fn(string, bool)) {
    let id = event::source();
    event::on(id, fn(payload) {
        let fields = json::parse(payload) as {string: any};
        handler(fields["id"] as string, fields["on"] as bool);
    });
    browser::candela_browser_on_fullscreen_change(id);
}
@cfg(not(web))
fn on_fullscreen_change(handler: fn(string, bool)) {
    throw "browser_only";
}
