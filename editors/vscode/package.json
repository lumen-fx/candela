{
  "name": "candela",
  "displayName": "Candela",
  "description": "Syntax highlighting, language configuration, snippets, and language server (diagnostics, hover, completion, go-to-definition, outline) for the Candela language (.cdl), the Lumen framework's scripting language.",
  "version": "0.2.0",
  "publisher": "lumen-fx",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "candela",
    "cdl",
    "lumen",
    "keel"
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/lumen-fx/candela"
  },
  "bugs": {
    "url": "https://github.com/lumen-fx/candela/issues"
  },
  "homepage": "https://github.com/lumen-fx/candela",
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:candela"
  ],
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "candela",
        "aliases": [
          "Candela",
          "candela"
        ],
        "extensions": [
          ".cdl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "candela",
        "scopeName": "source.candela",
        "path": "./syntaxes/candela.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "candela",
        "path": "./snippets/candela.json"
      }
    ],
    "configuration": {
      "title": "Candela",
      "properties": {
        "candela.languageServerPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `candela-lsp` binary. Leave empty to use `candela-lsp` (or `candela-lsp.exe` on Windows) from `PATH`. Set this to point at a locally-built server, e.g. one built from the repo's `lsp/` crate."
        }
      }
    }
  }
}
