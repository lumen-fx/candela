{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Candela",
  "scopeName": "source.candela",
  "patterns": [
    { "include": "#comments" },
    { "include": "#macro" },
    { "include": "#import" },
    { "include": "#host-dylib" },
    { "include": "#struct-declaration" },
    { "include": "#enum-declaration" },
    { "include": "#impl-declaration" },
    { "include": "#function-declaration" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#struct-literal" },
    { "include": "#function-call" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.candela",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.candela" }
          }
        }
      ]
    },
    "macro": {
      "patterns": [
        {
          "begin": "\\b([A-Za-z_][A-Za-z0-9_]*)(!)(\\()",
          "end": "\\)",
          "contentName": "meta.embedded.block.candela",
          "beginCaptures": {
            "1": { "name": "entity.name.function.macro.candela" },
            "2": { "name": "keyword.operator.macro.candela" },
            "3": { "name": "punctuation.section.macro.begin.candela" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.macro.end.candela" }
          },
          "patterns": [{ "include": "#macro-region" }]
        }
      ]
    },
    "macro-region": {
      "patterns": [
        { "match": "\"(?:[^\"\\\\]|\\\\.)*\"" },
        { "match": "//[^\\n]*" },
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [{ "include": "#macro-region" }]
        }
      ]
    },
    "import": {
      "patterns": [
        {
          "match": "\\b(import)\\b(?:\\s+(\"(?:[^\"\\\\]|\\\\.)*\"))?(?:\\s+(as)\\b\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.control.import.candela" },
            "2": { "name": "string.quoted.double.candela" },
            "3": { "name": "keyword.control.import.candela" },
            "4": { "name": "entity.name.namespace.candela" }
          }
        }
      ]
    },
    "host-dylib": {
      "patterns": [
        {
          "match": "\\b(host|dylib)\\b\\s*(\"(?:[^\"\\\\]|\\\\.)*\")?",
          "captures": {
            "1": { "name": "keyword.control.import.candela" },
            "2": { "name": "string.quoted.double.candela" }
          }
        }
      ]
    },
    "struct-declaration": {
      "patterns": [
        {
          "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.struct.candela" },
            "2": { "name": "entity.name.type.struct.candela" }
          }
        }
      ]
    },
    "enum-declaration": {
      "patterns": [
        {
          "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.enum.candela" },
            "2": { "name": "entity.name.type.enum.candela" }
          }
        }
      ]
    },
    "impl-declaration": {
      "patterns": [
        {
          "match": "\\b(impl)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.impl.candela" },
            "2": { "name": "entity.name.type.candela" }
          }
        }
      ]
    },
    "function-declaration": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.candela" },
            "2": { "name": "entity.name.function.candela" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.candela",
          "match": "\\b(if|else|match|while|for|in|loop|return|break|continue|try|catch)\\b"
        },
        {
          "name": "keyword.control.import.candela",
          "match": "\\b(import|as|host|dylib)\\b"
        },
        {
          "name": "storage.type.candela",
          "match": "\\b(fn|let|struct|enum|impl)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.candela",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.candela",
          "match": "\\b(null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.candela",
          "match": "\\b(int|float|bool|string)\\b"
        },
        {
          "name": "entity.name.type.candela",
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\b"
        }
      ]
    },
    "struct-literal": {
      "patterns": [
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(?=\\{)",
          "captures": {
            "1": { "name": "entity.name.type.struct.candela" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.candela" }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)",
          "captures": {
            "1": { "name": "entity.name.namespace.candela" },
            "2": { "name": "punctuation.accessor.candela" }
          }
        },
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.candela" },
            "2": { "name": "entity.name.function.member.candela" }
          }
        },
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.candela" },
            "2": { "name": "variable.other.property.candela" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.candela",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.candela" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.candela" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.candela",
              "match": "\\\\(?:[nrt0\"\\\\])"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.candela",
          "match": "\\b[0-9]*\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.candela",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.variadic.candela",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.assignment.compound.candela",
          "match": "(\\+=|-=|\\*=|/=|%=|\\^=)"
        },
        {
          "name": "keyword.operator.comparison.candela",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.candela",
          "match": "(\\|\\||&&|!)"
        },
        {
          "name": "keyword.operator.assignment.candela",
          "match": "="
        },
        {
          "name": "keyword.operator.range.candela",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.arithmetic.candela",
          "match": "(\\+|-|\\*|/|%|\\^)"
        },
        {
          "name": "keyword.operator.pipe.candela",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.arrow.candela",
          "match": "(->|=>)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "keyword.operator.variadic.candela",
          "match": "\\.\\.\\."
        },
        {
          "name": "punctuation.accessor.namespace.candela",
          "match": "::"
        },
        {
          "name": "punctuation.separator.candela",
          "match": "[,:;]"
        },
        {
          "name": "punctuation.accessor.candela",
          "match": "\\."
        },
        {
          "name": "punctuation.bracket.candela",
          "match": "[\\[\\]{}()]"
        }
      ]
    }
  }
}
