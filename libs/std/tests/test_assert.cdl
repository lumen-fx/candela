/// Checks for the `assert` module: the passing paths must run without raising.
/// Prints "assert ok" on success; a failed check aborts the run with a message.
import "std/assert";

fn main() {
    assert(true);
    assert_msg(true, "unused");
    assert_true(1 == 1);
    assert_false(1 == 2);
    assert_eq("a", "a");
    assert_eq(42, 42);
    assert_ne("a", "b");
    assert_ne(1, 2);
    print("assert ok");
}
