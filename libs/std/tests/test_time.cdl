import "std/assert";
import "std/time";

fn main() {
    assert::is_true(time::now_ms() >= time::now() * 1000 - 5000);
    let start = time::clock_ns();
    time::sleep_ms(5);
    assert::is_true(time::clock_ns() - start >= 5000000);
    assert::eq(time::format_utc(1700000000, "%Y-%m-%dT%H:%M:%SZ"), "2023-11-14T22:13:20Z");
    assert::eq(time::parse_iso("1970-01-01"), Some(0));
    assert::eq(time::parse_iso("2023-11-14T22:13:20Z"), Some(1700000000));
    assert::eq(time::parse_iso("2023-11-14 23:13:20.25+01:00"), Some(1700000000));
    assert::eq(time::parse_iso("1969-12-31T23:59:59Z"), Some(-1));
    assert::eq(time::parse_iso("2023-11-14T22:13"), None);
    assert::eq(time::parse_iso("2023-13-01"), None);
    let ticks = 0;
    let every = time::every(5) fn() { ticks += 1; };
    let never = time::after(60000) fn() { print("never"); };
    assert::is_true(never.cancel());
    assert::is_false(never.cancel());
    time::after(40) fn() {
        assert::is_true(ticks >= 2);
        assert::is_true(every.cancel());
        print("time ok");
    };
}
