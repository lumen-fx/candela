/// Checks the collection higher-order methods (`arr.map(f)`, `arr.filter(f)`,
/// ...), which resolve without an import: `std/list` loads automatically and
/// its `impl list` block supplies the methods. Prints "list methods ok" on
/// success; a failed check aborts the run.
import "std/assert";

fn double(x) {
    return x * 2;
}

fn is_even(x) {
    return x % 2 == 0;
}

fn main() {
    let xs = [1, 2, 3, 4];

    // map/filter/reduce as methods, named and anonymous function arguments
    assert::eq(xs.map(double), [2, 4, 6, 8]);
    assert::eq(xs.map(fn(x) => x * x), [1, 4, 9, 16]);
    assert::eq(xs.filter(is_even), [2, 4]);
    assert::eq(xs.filter(fn(x) => x > 2), [3, 4]);
    assert::eq(xs.reduce(0, fn(a, b) => a + b), 10);
    assert::eq(xs.reduce(1, fn(a, b) => a * b), 24);

    // predicate find/any/all as methods
    assert::eq(xs.find(is_even), Some(2));
    assert::eq(xs.find(fn(x) => x > 10), None);
    assert::is_true(xs.any(is_even));
    assert::is_false(xs.all(is_even));
    assert::is_true([2, 4, 6].all(is_even));

    // sort_by as a method
    assert::eq([3, 1, 2].sort_by(fn(a, b) => a < b), [1, 2, 3]);
    assert::eq([1, 2, 3].sort_by(fn(a, b) => a > b), [3, 2, 1]);

    // reductions and slicers as methods
    assert::eq(xs.first(), Some(1));
    assert::eq(xs.last(), Some(4));
    assert::eq(xs.sum(), 10);
    assert::eq(xs.min(), Some(1));
    assert::eq(xs.max(), Some(4));
    assert::eq(xs.take(2), [1, 2]);
    assert::eq(xs.drop(2), [3, 4]);
    assert::is_false(xs.is_empty());

    // chaining methods together
    assert::eq(xs.filter(is_even).map(double), [4, 8]);

    // each runs its function for its side effect
    xs.each(double);
    assert::eq(xs.map(double), [2, 4, 6, 8]);

    print("list methods ok");
}
