/// Checks for the `string` module. Run with `candela run`, or build to a `.cdlb`
/// and run under `candela-vm`. Prints "string ok" on success; a failed check
/// aborts the run with a message.
import "std/string";
import "std/assert";

fn main() {
    assert::eq("hello world".substring(6, 5), "world");
    assert::eq("abc".char_at(1), "b");
    assert::is_true("".is_empty());
    assert::is_false("x".is_empty());
    assert::eq("hello".capitalize(), "Hello");
    assert::eq("".capitalize(), "");
    assert::eq("a\nb\nc".lines().len(), 3);
    assert::eq("7".pad_left(3, "0"), "007");
    assert::eq("7".pad_right(3, "0"), "700");
    assert::eq("banana".count("a"), 3);
    assert::eq("aaaa".count("aa"), 2);
    assert::eq("abc".chars().len(), 3);
    assert::eq("abc".chars().join("-"), "a-b-c");
    assert::eq("".chars().len(), 0);

    // Methods chain with the built-in string methods.
    assert::eq("  hi  ".trim().capitalize(), "Hi");
    print("string ok");
}
