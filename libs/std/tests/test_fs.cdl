import "std/assert";
import "std/fs";
import "std/hash";

// Runs in a scratch directory the caller names as the first argument.
fn main() {
    let root = argv()[0];
    let dir = root + "/a/b";
    fs::mkdir(dir)?;
    fs::mkdir(dir)?;
    assert::is_true(fs::is_dir(dir));
    assert::is_false(fs::is_dir(root + "/missing"));

    fs::write(dir + "/z.txt", "hello")?;
    fs::write(dir + "/a.txt", "")?;
    assert::eq(fs::list(dir)?, ["a.txt", "z.txt"]);
    assert::eq(fs::list(root)?, ["a"]);

    fs::copy(dir + "/z.txt", root + "/copy.txt")?;
    assert::eq(fs::read(root + "/copy.txt")?, "hello");
    assert::eq(fs::copy(dir, root + "/nope"), Err("fs_is_a_directory"));

    fs::write_bytes(root + "/b.bin", [0, 1, 127, 255])?;
    assert::eq(fs::read_bytes(root + "/b.bin")?, [0, 1, 127, 255]);
    assert::eq(fs::write_bytes(root + "/bad.bin", [1, 256]), Err("fs_not_a_byte"));
    assert::is_false(fs::exists(root + "/bad.bin"));

    assert::eq(hash::file(dir + "/z.txt", "md5")?, "5d41402abc4b2a76b9719d911017c592");
    assert::eq(hash::file(dir + "/z.txt", "sha1")?, "aaf4c61ddcc5e8a2dabede0f3b482cd9aea9434d");
    assert::eq(
        hash::file(dir + "/z.txt", "sha256")?,
        "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824",
    );
    assert::eq(hash::file(dir + "/a.txt", "md5")?, "d41d8cd98f00b204e9800998ecf8427e");
    assert::eq(hash::file(dir + "/z.txt", "crc32"), Err("hash_unknown_algorithm"));
    assert::eq(hash::file(root + "/missing", "md5"), Err("fs_not_found"));

    assert::eq(fs::delete_dir(root + "/a"), Err("fs_directory_not_empty"));

    assert::eq(fs::size(dir + "/z.txt")?, 5);
    assert::is_true(fs::modified(dir + "/z.txt")? > 0);
    assert::eq(fs::size(root + "/missing"), Err("fs_not_found"));
    fs::rename(dir + "/z.txt", dir + "/moved.txt")?;
    assert::is_false(fs::exists(dir + "/z.txt"));
    assert::eq(fs::read(dir + "/moved.txt")?, "hello");
    assert::is_true(fs::absolute("x")?.ends_with("x"));
    assert::is_true(fs::absolute(root)?.len() >= root.len());
    fs::delete_all(root + "/a")?;
    assert::is_false(fs::exists(root + "/a"));
    assert::eq(fs::delete_all(root + "/a"), Err("fs_not_found"));

    print("fs ok");
}
