/// Checks for the `result` module. Run with `candela run`, or build to a
/// `.cdlb` and run under `candela-vm`. Prints "result ok" on success; a failed
/// check aborts the run with a message.
import "std/result";
import "std/assert" as assert;

struct Config { port: int }

fn load(text: string) -> Result<Config, string> {
    if text.is_int() {
        return Ok(Config { port: int(text) });
    }
    return Err("not a port: " + text);
}

fn main() {
    let ok = Ok(5);
    let err = Err("boom");

    assert::assert_true(ok.is_ok());
    assert::assert_false(err.is_ok());
    assert::assert_true(err.is_err());
    assert::assert_false(ok.is_err());

    assert::assert_eq(ok.unwrap(), 5);
    assert::assert_eq(err.unwrap_err(), "boom");
    assert::assert_eq(err.unwrap_or(42), 42);
    assert::assert_eq(ok.unwrap_or(42), 5);

    // A struct payload comes back out as the struct, not as `any`, and both
    // sides of one function's result keep their own type.
    match load("8080") {
        Ok(config) => { assert::assert_eq(config.port, 8080); }
        Err(reason) => { assert::assert_true(false); }
    }
    match load("http") {
        Ok(config) => { assert::assert_true(false); }
        Err(reason) => { assert::assert_eq(reason, "not a port: http"); }
    }

    print("result ok");
}
