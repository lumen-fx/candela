/// Checks for the `result` module. Run with `candela run`, or build to a
/// `.cdlb` and run under `candela-vm`. Prints "result ok" on success; a failed
/// check aborts the run with a message.
import "std/result";
import "std/assert";

struct Config { port: int }

fn load(text: string) -> Result<Config, string> {
    if text.parse<int>() is Some(port) {
        return Ok(Config { port: port });
    }
    return Err("not a port: " + text);
}

fn twice(x) { return (x as int) * 2; }

fn shout(e) { return (e as string) + "!"; }

// A step that may fail on its own, for and_then to chain.
fn halve(x) {
    let n = x as int;
    if n % 2 == 0 {
        return Ok(n / 2);
    }
    return Err("odd");
}

fn main() {
    let ok = Ok(5);
    let err = Err("boom");

    assert::is_true(ok.is_ok());
    assert::is_false(err.is_ok());
    assert::is_true(err.is_err());
    assert::is_false(ok.is_err());

    assert::eq(ok.unwrap(), 5);
    assert::eq(err.unwrap_err(), "boom");
    assert::eq(err.unwrap_or(42), 42);
    assert::eq(ok.unwrap_or(42), 5);

    // map works one side at a time and leaves the other alone.
    assert::eq(ok.map(twice).unwrap(), 10);
    assert::eq(err.map(twice).unwrap_err(), "boom");
    assert::eq(err.map_err(shout).unwrap_err(), "boom!");
    assert::eq(ok.map_err(shout).unwrap(), 5);

    // and_then chains a step that may fail; map would nest.
    assert::eq(Ok(8).and_then(halve).unwrap(), 4);
    assert::eq(Ok(7).and_then(halve).unwrap_err(), "odd");
    assert::eq(err.and_then(halve).unwrap_err(), "boom");

    // ok drops the error side. `Some` and `None` come from the option module
    // this one imports, with no import of its own here.
    assert::eq(ok.ok().unwrap(), 5);
    assert::is_true(err.ok().is_none());

    // A struct payload comes back out as the struct, not as `any`, and both
    // sides of one function's result keep their own type.
    match load("8080") {
        Ok(config) => { assert::eq(config.port, 8080); }
        Err(reason) => { assert::is_true(false); }
    }
    match load("http") {
        Ok(config) => { assert::is_true(false); }
        Err(reason) => { assert::eq(reason, "not a port: http"); }
    }

    print("result ok");
}
