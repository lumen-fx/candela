/// Checks for the `result` module. Run with `candela run`, or build to a
/// `.cdlb` and run under `candela-vm`. Prints "result ok" on success; a failed
/// check aborts the run with a message.
import "std/result";
import "std/assert" as assert;

fn main() {
    let ok = Ok(5);
    let err = Err("boom");

    assert::assert_true(ok.is_ok());
    assert::assert_false(err.is_ok());
    assert::assert_true(err.is_err());
    assert::assert_false(ok.is_err());

    assert::assert_eq(ok.unwrap(), 5);
    assert::assert_eq(err.unwrap_err(), "boom");
    assert::assert_eq(err.unwrap_or(42), 42);
    assert::assert_eq(ok.unwrap_or(42), 5);

    print("result ok");
}
