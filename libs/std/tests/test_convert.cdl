/// Checks for the `convert` module. Prints "convert ok" on success; a failed
/// check aborts the run with a message.
import "std/convert";
import "std/assert";

fn main() {
    assert_eq(to_int("42"), 42);
    assert_eq(to_float("1.5"), 1.5);
    assert_eq(to_string(42), "42");
    assert_true(to_bool("true"));
    assert_false(to_bool("false"));
    print("convert ok");
}
