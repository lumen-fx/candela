/// Checks for the `convert` module. Prints "convert ok" on success; a failed
/// check aborts the run with a message.
import "../convert.cdl" as convert;
import "../assert.cdl" as assert;

fn main() {
    assert::assert_eq(convert::to_int("42"), 42);
    assert::assert_eq(convert::to_float("1.5"), 1.5);
    assert::assert_eq(convert::to_string(42), "42");
    assert::assert_true(convert::to_bool("true"));
    assert::assert_false(convert::to_bool("false"));
    print("convert ok");
}
