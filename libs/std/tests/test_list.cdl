/// Checks for the `list` module (reductions and lookups). Run with `candela
/// run`, or build to a `.cdlb` and run under `candela-vm`. Prints "list ok" on
/// success; a failed check aborts the run with a message.
import "std/assert";

fn main() {
    assert::eq([10, 20, 30].first(), Some(10));
    assert::eq([10, 20, 30].last(), Some(30));
    let none = [1];
    none.remove(0);
    assert::is_true(none.first().is_none());
    assert::is_true(none.last().is_none());
    assert::is_true(none.min().is_none());
    assert::is_true(none.max().is_none());
    assert::is_true([].is_empty());
    assert::eq([1, 2, 3, 4].sum(), 10);
    assert::eq([1.5, 2.5].sum(), 4.0);
    assert::eq([1, 2, 3, 4].product(), 24);
    assert::eq([3, 1, 2].min(), Some(1));
    assert::eq([3, 1, 2].max().unwrap_or(0), 3);
    assert::eq([5, 6, 7].index_of(6), Some(1));
    assert::eq([5, 6, 7].index_of(9), None);
    assert::eq([1, 1, 2, 1].count(1), 3);
    print("list ok");
}
