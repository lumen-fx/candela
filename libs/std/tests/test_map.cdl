/// Checks for the `map` module and the map primitives. Prints "map ok" on
/// success; a failed check aborts the run with a message.
import "std/map";
import "std/assert";

fn main() {
    // Empty-literal, insert, len.
    let m = {};
    assert::is_true(m.is_empty());
    m["a"] = 1;
    m["b"] = 2;
    m["c"] = 3;
    assert::eq(m.len(), 3);
    assert::is_false(m.is_empty());

    // get / contains.
    assert::eq(m["b"], 2);
    assert::is_true(m.contains("a"));
    assert::is_false(m.contains("z"));
    assert::eq(m.get("c").unwrap_or(99), 3);
    assert::eq(m.get("z").unwrap_or(99), 99);

    // keys / values.
    assert::eq(m.keys().len(), 3);
    assert::eq(m.values().len(), 3);

    // Iteration walks the keys; the values sum to 1+2+3.
    let sum = 0;
    for k in m {
        sum += m[k];
    }
    assert::eq(sum, 6);

    // Overwrite keeps the length and replaces the value.
    m["a"] = 10;
    assert::eq(m.len(), 3);
    assert::eq(m["a"], 10);

    // The keys come back in the order they went in. Overwriting "a" left it
    // first; removing "b" and inserting it again makes it the newest entry.
    assert::eq(m.keys(), ["a", "b", "c"]);
    assert::eq(m.values(), [10, 2, 3]);
    m.remove("b");
    m["b"] = 2;
    assert::eq(m.keys(), ["a", "c", "b"]);

    // Two maps holding the same entries are equal whatever order built them.
    let one = {"x": 1, "y": 2};
    let two = {"y": 2, "x": 1};
    assert::is_true(one == two);

    // Non-string keys.
    let byint = {};
    byint[1] = 100;
    byint[2] = 200;
    assert::eq(byint[2], 200);
    assert::is_true(byint.contains(1));

    print("map ok");
}
