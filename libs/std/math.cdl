dylib "../std_src/math/math" {
    fn candela_acos(x: float) -> float;
    fn candela_asin(x: float) -> float;
    fn candela_atan(x: float) -> float;
    fn candela_atan2(y: float, x: float) -> float;
    fn candela_cos(x: float) -> float;
    fn candela_sin(x: float) -> float;
    fn candela_tan(x: float) -> float;
    fn candela_acosh(x: float) -> float;
    fn candela_asinh(x: float) -> float;
    fn candela_atanh(x: float) -> float;
    fn candela_cosh(x: float) -> float;
    fn candela_sinh(x: float) -> float;
    fn candela_tanh(x: float) -> float;
    fn candela_exp(x: float) -> float;
    fn candela_expm1(x: float) -> float;
    fn candela_log(x: float) -> float;
    fn candela_log10(x: float) -> float;
    fn candela_log2(x: float) -> float;
    fn candela_log1p(x: float) -> float;
    fn candela_logb(x: float) -> float;
    fn candela_ldexp(x: float, exp: int) -> float;
    fn candela_ilogb(x: float) -> int;
    fn candela_scalbn(x: float, exp: int) -> float;
    fn candela_cbrt(x: float) -> float;
    fn candela_hypot(x: float, y: float) -> float;
    fn candela_erf(x: float) -> float;
    fn candela_erfc(x: float) -> float;
    fn candela_pow(base: float, exp: float) -> float;
    fn candela_fmod(x: float, y: float) -> float;
    fn candela_copysign(x: float, sign: float) -> float;
}

fn acos(x) { return math::candela_acos(x); }
fn asin(x) { return math::candela_asin(x); }
fn atan(x) { return math::candela_atan(x); }
fn atan2(x, y) { return math::candela_atan2(x, y); }
fn cos(x) { return math::candela_cos(x); }
fn sin(x) { return math::candela_sin(x); }
fn tan(x) { return math::candela_tan(x); }
fn acosh(x) { return math::candela_acosh(x); }
fn asinh(x) { return math::candela_asinh(x); }
fn atanh(x) { return math::candela_atanh(x); }
fn cosh(x) { return math::candela_cosh(x); }
fn sinh(x) { return math::candela_sinh(x); }
fn tanh(x) { return math::candela_tanh(x); }
fn exp(x) { return math::candela_exp(x); }
fn expm1(x) { return math::candela_expm1(x); }
fn log(x) { return math::candela_log(x); }
fn log10(x) { return math::candela_log10(x); }
fn log2(x) { return math::candela_log2(x); }
fn log1p(x) { return math::candela_log1p(x); }
fn logb(x) { return math::candela_logb(x); }
fn ldexp(x, y) { return math::candela_ldexp(x, y); }
fn ilogb(x) { return math::candela_ilogb(x); }
fn scalbn(x, y) { return math::candela_scalbn(x, y); }
fn cbrt(x) { return math::candela_cbrt(x); }
fn hypot(x, y) { return math::candela_hypot(x, y); }
fn erf(x) { return math::candela_erf(x); }
fn erfc(x) { return math::candela_erfc(x); }
fn pow(x, y) { return math::candela_pow(x, y); }
fn fmod(x, y) { return math::candela_fmod(x, y); }
fn copysign(x, y) { return math::candela_copysign(x, y); }

/// The ratio of a circle's circumference to its diameter.
fn pi() { return 3.141592653589793; }
/// The base of the natural logarithm.
fn e() { return 2.718281828459045; }
/// The ratio of a circle's circumference to its radius (2 * pi).
fn tau() { return 6.283185307179586; }