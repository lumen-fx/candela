/// The `Result` type: either a success (`Ok`) or a failure (`Err`), built on
/// candela's native enums.
///
///     import "std/result";
///     let r = Ok(5);
///     match r {
///         Ok(v) => { print(v); }
///         Err(e) => { print(e); }
///     }
///
/// The helpers are methods on the value (`r.unwrap()`, `r.is_ok()`). This
/// module is pure candela and inlines into a `.cdlb`, so it runs under
/// `candela-vm` with no source tree.
///
/// `ok` hands the success side back as an `Option`, so the module imports
/// `std/option`. A program that imports both gets one `Option`.

import "std/option";

enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl Result<T, E> {
    /// True when the result is `Ok`.
    fn is_ok(self) {
        match self {
            Ok(_) => { return true; }
            Err(_) => { return false; }
        }
    }

    /// True when the result is `Err`.
    fn is_err(self) {
        match self {
            Ok(_) => { return false; }
            Err(_) => { return true; }
        }
    }

    /// Returns the success value, or raises when the result is `Err`.
    fn unwrap(self) -> T {
        let value = null;
        match self {
            Ok(v) => { value = v; }
            Err(e) => { throw("called unwrap on an Err result"); }
        }
        return value;
    }

    /// Returns the error value, or raises when the result is `Ok`.
    fn unwrap_err(self) -> E {
        let value = null;
        match self {
            Ok(v) => { throw("called unwrap_err on an Ok result"); }
            Err(e) => { value = e; }
        }
        return value;
    }

    /// Returns the success value, or `default` when the result is `Err`.
    fn unwrap_or(self, default: T) -> T {
        let value = default;
        match self {
            Ok(v) => { value = v; }
            Err(e) => { value = default; }
        }
        return value;
    }

    /// Applies `f` to the success value, returning a new result. An `Err`
    /// passes through without calling `f`.
    fn map(self, f) {
        match self {
            Ok(v) => { return Ok(f(v)); }
            Err(e) => { return Err(e); }
        }
    }

    /// Applies `f` to the error value, returning a new result. An `Ok` passes
    /// through without calling `f`.
    fn map_err(self, f) {
        match self {
            Ok(v) => { return Ok(v); }
            Err(e) => { return Err(f(e)); }
        }
    }

    /// Applies `f`, which returns a result of its own, to the success value.
    /// An `Err` passes through without calling `f`.
    fn and_then(self, f) {
        match self {
            Ok(v) => { return f(v); }
            Err(e) => { return Err(e); }
        }
    }

    /// The success side as an option: `Some` of the value for an `Ok`, and
    /// `None` for an `Err`, which drops the error.
    fn ok(self) {
        match self {
            Ok(v) => { return Some(v); }
            Err(e) => { return None; }
        }
    }
}
