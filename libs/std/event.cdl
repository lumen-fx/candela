/// Events: results that arrive from work running somewhere else, such as a
/// native library's thread or a browser promise, delivered to a closure.
///
/// Work started under a source posts events to it, each carrying one string,
/// JSON by convention. `on` names the closure that receives a source's events.
/// The program runs it on its own thread, one event at a time, in the order
/// the events were posted.
///
///     import "std/event";
///     let id = event::source();
///     event::on(id, fn(payload: string) { print(payload); });
///
/// After `main` returns, the program keeps running handlers for as long as
/// some work it started is still running, then exits. A host that runs its own
/// loop calls `dispatch_events` on the program instead.

/// A new source: an int no other source in the process shares.
fn source() -> int => event_source();

/// Runs `handler` with the payload of every event posted under `id` from now
/// on, replacing any handler `id` had. The handler is let go once the work
/// under `id` has finished and its last event has been handled.
fn on(id: int, handler: fn(string)) {
    event_on(id, handler);
}

/// Runs the handlers of events that have arrived, at most `budget` of them, or
/// every one when `budget` is negative, and answers how many ran. With `wait`,
/// waits for more while work under some source is still running; without it,
/// answers as soon as nothing is queued.
///
/// The runtime calls this after `main` returns. A program whose `main` loops
/// on its own calls it with `wait` false to run what arrived since the last
/// call.
fn dispatch(budget: int, wait: bool) -> int {
    let done = 0;
    while budget < 0 || done < budget {
        let next = event_next(wait);
        if next.len() == 0 {
            return done;
        }
        let handler = next[1] as fn(string);
        handler(next[2] as string);
        done += 1;
    }
    return done;
}
