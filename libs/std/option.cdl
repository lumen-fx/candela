/// The `Option` type: a value that is either present (`Some`) or absent
/// (`None`), built on candela's native enums.
///
/// `Option` is an ordinary enum, so `Some(x)` and `None` are constructed
/// directly and matched with payload binding:
///
///     import std::option;
///     let o = Some(5);
///     match o {
///         Some(v) => { print(v); }
///         None => { print("nothing"); }
///     }
///
/// The helpers below work either as free functions (`option::unwrap(o)`) or as
/// methods on the value (`o.unwrap()`). This module is pure candela and inlines
/// into a `.cdlb`, so it runs under `candela-vm` with no source tree.

enum Option {
    Some(any),
    None,
}

/// True when the option holds a value.
fn is_some(o) {
    match o {
        Some(_) => { return true; }
        None => { return false; }
    }
}

/// True when the option is empty.
fn is_none(o) {
    match o {
        Some(_) => { return false; }
        None => { return true; }
    }
}

/// Returns the contained value, or raises when the option is `None`.
fn unwrap(o) {
    let value = null;
    match o {
        Some(v) => { value = v; }
        None => { throw("called unwrap on a None option"); }
    }
    return value;
}

/// Returns the contained value, or `default` when the option is `None`.
fn unwrap_or(o, default) {
    let value = default;
    match o {
        Some(v) => { value = v; }
        None => { value = default; }
    }
    return value;
}

/// Applies `f` to the contained value, returning a new option.
fn map(o, f) {
    match o {
        Some(v) => { return Some(f(v)); }
        None => { return None; }
    }
}

impl Option {
    fn is_some(self) {
        match self {
            Some(_) => { return true; }
            None => { return false; }
        }
    }
    fn is_none(self) {
        match self {
            Some(_) => { return false; }
            None => { return true; }
        }
    }
    fn unwrap(self) {
        let value = null;
        match self {
            Some(v) => { value = v; }
            None => { throw("called unwrap on a None option"); }
        }
        return value;
    }
    fn unwrap_or(self, default) {
        let value = default;
        match self {
            Some(v) => { value = v; }
            None => { value = default; }
        }
        return value;
    }
    fn map(self, f) {
        match self {
            Some(v) => { return Some(f(v)); }
            None => { return None; }
        }
    }
}
