/// The `Option` type: a value that is either present (`Some`) or absent
/// (`None`), built on candela's native enums.
///
/// `Option` is an ordinary generic enum, so `Some(x)` and `None` are
/// constructed directly, without a type argument, and matched with payload
/// binding:
///
///     import "std/option";
///     let o = Some(5);
///     match o {
///         Some(v) => { print(v); }
///         None => { print("nothing"); }
///     }
///
/// The helpers are methods on the value (`o.unwrap()`, `o.is_some()`). This
/// module is pure candela and inlines into a `.cdlb`, so it runs under
/// `candela-vm` with no source tree.

enum Option<T> {
    Some(T),
    None,
}

impl Option<T> {
    /// True when the option holds a value.
    fn is_some(self) {
        match self {
            Some(_) => { return true; }
            None => { return false; }
        }
    }

    /// True when the option is empty.
    fn is_none(self) {
        match self {
            Some(_) => { return false; }
            None => { return true; }
        }
    }

    /// Returns the contained value, or raises when the option is `None`.
    fn unwrap(self) -> T {
        let value = null;
        match self {
            Some(v) => { value = v; }
            None => { throw("called unwrap on a None option"); }
        }
        return value;
    }

    /// Returns the contained value, or `default` when the option is `None`.
    fn unwrap_or(self, default: T) -> T {
        let value = default;
        match self {
            Some(v) => { value = v; }
            None => { value = default; }
        }
        return value;
    }

    /// Applies `f` to the contained value, returning a new option.
    fn map(self, f) {
        match self {
            Some(v) => { return Some(f(v)); }
            None => { return None; }
        }
    }

    /// Applies `f`, which returns an option of its own, to the contained
    /// value. A `None` passes through without calling `f`.
    fn and_then(self, f) {
        match self {
            Some(v) => { return f(v); }
            None => { return None; }
        }
    }

    /// This option when it holds a value, and `other` when it is empty.
    fn or(self, other) {
        match self {
            Some(v) => { return Some(v); }
            None => { return other; }
        }
    }

    /// This option when `pred` answers true for the contained value, and an
    /// empty one otherwise.
    fn filter(self, pred) {
        match self {
            Some(v) => {
                if pred(v) {
                    return Some(v);
                }
                return None;
            }
            None => { return None; }
        }
    }
}
