/// String methods built on Candela's string operators and built-in methods.
///
/// Every helper is a method on the string value (`s.capitalize()`,
/// `s.pad_left(8, " ")`), defined in an `impl string` block; import the module
/// to bring them in. This module is pure Candela: it uses only indexing,
/// slicing, concatenation, and the built-in string methods, so it compiles
/// into a `.cdlb` artifact and runs under `candela-vm` with no dynamic
/// library.

impl string {
    /// The substring starting at `start` (0-based) and spanning `count`
    /// characters.
    fn substring(self, start, count) {
        return self[start..start + count];
    }

    /// The character at index `i`, returned as a one-character string.
    fn char_at(self, i) {
        return self[i..i + 1];
    }

    /// True when the string has no characters.
    fn is_empty(self) {
        return self.len() == 0;
    }

    /// The string with its first character upper-cased and the rest left
    /// unchanged.
    fn capitalize(self) {
        if self.len() == 0 {
            return self;
        }
        return self[0..1].uppercase() + self[1..self.len()];
    }

    /// The lines of the string, split on newline boundaries.
    fn lines(self) {
        return self.split("\n");
    }

    /// The string padded on the left with the one-character string `fill`
    /// until it is at least `width` characters wide.
    fn pad_left(self, width, fill) {
        let out = self;
        while out.len() < width {
            out = fill + out;
        }
        return out;
    }

    /// The string padded on the right with the one-character string `fill`
    /// until it is at least `width` characters wide.
    fn pad_right(self, width, fill) {
        let out = self;
        while out.len() < width {
            out = out + fill;
        }
        return out;
    }

    /// The number of non-overlapping occurrences of `needle`.
    fn count(self, needle) {
        if needle.len() == 0 {
            return 0;
        }
        let n = 0;
        let i = 0;
        while i + needle.len() <= self.len() {
            if self[i..i + needle.len()] == needle {
                n = n + 1;
                i = i + needle.len();
            } else {
                i = i + 1;
            }
        }
        return n;
    }
}
