dylib "../std_src/random/random" {
    fn candela_seed(seed: int);
    fn candela_random_int() -> int;
    fn candela_random_int_range(min: int, max: int) -> int;
    fn candela_random() -> float;
    fn candela_random_float_range(min: float, max: float) -> float;
}

fn seed(s) { random::candela_seed(s); }
fn int() { return random::candela_random_int(); }
fn int_range(min, max) {
    if min > max {
        throw "random_min_above_max";
    }
    return random::candela_random_int_range(min, max);
}
fn float() { return random::candela_random(); }
fn float_range(min, max) {
    return random::candela_random_float_range(min, max);
}

/// A random version 4 UUID, as 36 lowercase characters:
/// `xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx`. It comes from the same generator as
/// the rest of this module, so `seed` makes it repeat.
fn uuid() -> string {
    let digits = "0123456789abcdef";
    let out: string[] = [];
    let i = 0;
    while i < 32 {
        if i == 8 || i == 12 || i == 16 || i == 20 {
            out.push("-");
        }
        let n = int_range(0, 15);
        if i == 12 {
            n = 4;
        } else if i == 16 {
            n = (n & 3) | 8;
        }
        out.push(digits.char_at(n));
        i += 1;
    }
    return out.join("");
}

/// One element of `xs`, each equally likely, or `None` when it is empty.
fn choice<T>(xs: T[]) -> T? {
    if xs.len() == 0 {
        return None;
    }
    return Some(xs[int_range(0, xs.len() - 1)]);
}

/// Puts the elements of `xs` in a random order, in place.
fn shuffle<T>(xs: T[]) {
    let i = xs.len() - 1;
    while i > 0 {
        let j = int_range(0, i);
        let held = xs[i];
        xs[i] = xs[j];
        xs[j] = held;
        i -= 1;
    }
}
