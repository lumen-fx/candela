dylib "../std_src/random/random" {
    fn candela_seed(seed: int);
    fn candela_random_int() -> int;
    fn candela_random_int_range(min: int, max: int) -> int;
    fn candela_random() -> float;
    fn candela_random_float_range(min: float, max: float) -> float;
}

fn seed(s) { random::candela_seed(s); }
fn int() { return random::candela_random_int(); }
fn int_range(min, max) {
    if min > max {
        throw "random_min_above_max";
    }
    return random::candela_random_int_range(min, max);
}
fn float() { return random::candela_random(); }
fn float_range(min, max) {
    return random::candela_random_float_range(min, max);
}