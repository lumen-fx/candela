/// Map methods that extend the built-in map operations.
///
/// A map holds key-value pairs. The core operations are built-in methods on a
/// map value (`m.get(k)`, `m.insert(k, v)`, `m.len()`, `m.contains(k)`,
/// `m.keys()`, `m.values()`), and a map iterates its keys
/// (`for k in m { ... }`). This module adds conveniences on top, defined in an
/// `impl map` block; import the module to bring them in.
///
/// The methods are polymorphic through Candela's compile-time
/// monomorphization: a single definition specializes to whatever key and value
/// types the call site uses.
///
/// This module is pure Candela and compiles into a `.cdlb` artifact that runs
/// under `candela-vm` with no dynamic library.

impl map {
    /// True when the map has no entries.
    fn is_empty(self) {
        return self.len() == 0;
    }

    /// The value stored under `k`, or `default` when the key is absent.
    fn get_or(self, k, default) {
        if self.contains(k) {
            return self.get(k);
        }
        return default;
    }
}
