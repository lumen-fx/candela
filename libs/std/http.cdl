/// HTTP: requests answered in memory, and downloads of a URL to a file.
///
/// `request` sends one request and passes its function the `Response`, or
/// the reason there is none. `download` starts a transfer and answers a `Transfer` at once. The
/// transfer runs on a thread of its own and reports to the function given to
/// `download`: `Received` as bytes arrive, then `Saved` with the path once the
/// whole file is in place, or `Failed` with the reason. `Saved` or `Failed` is
/// always the last event.
///
///     import "std/http";
///
///     fn main() {
///         http::download("https://example.com/pack.zip", "pack.zip") fn(e) {
///             match e {
///                 Received(received, Some(total)) => print(string(received) + " of " + string(total)),
///                 Received(received, None) => print(string(received)),
///                 Saved(path) => print("saved " + path),
///                 Failed(why) => eprint(why),
///             }
///         };
///     }
///
/// The destination only ever holds a complete file: the bytes land in a
/// temporary file beside it that replaces it once the body has arrived and
/// any checksum matched. A reply that is not a 2xx status fails the transfer.
/// The program keeps running after `main` returns until every transfer it
/// started has reported its last event.

import "std/event";
import "std/json";

@cfg(not(web))
dylib "../std_src/net/net" {
    fn candela_http_request(id: int, url: string, method: string, headers_json: string, body: string, timeout_ms: int, max_bytes: int);
    fn candela_http_download(id: int, url: string, path: string, checksum: string, timeout_ms: int, max_bytes: int);
    fn candela_http_cancel(handle: int) -> int;
    fn candela_http_set_max_concurrent(n: int);
}

@cfg(web)
host "http" {
    fn candela_http_request(id: int, url: string, method: string, headers_json: string, body: string, timeout_ms: int, max_bytes: int);
    fn candela_http_cancel(handle: int) -> int;
}

/// What a request got back.
struct Response {
    /// The status code, such as 200 or 404. Any status is a response; only a
    /// request that got none answers an error.
    status: int,
    /// The headers by lowercase name. A header sent more than once has its
    /// values joined with `, `.
    headers: {string: string},
    /// The body, as text.
    body: string,
}

/// What a download reports.
enum Progress {
    /// How many bytes have arrived, and how many the server said would;
    /// `None` when it did not say.
    Received(int, int?),
    /// The file is in place at this path.
    Saved(string),
    /// The transfer did not happen, or was cancelled (the message is then
    /// `cancelled`).
    Failed(string),
}

/// A transfer `download` started.
struct Transfer {
    /// The event source its events arrive under, for `event::wait`.
    id: int,
}

impl Transfer {
    /// Cancels the transfer. A download then reports `Failed("cancelled")` as
    /// its last event, and a request answers `Err("cancelled")`. False when it
    /// had already finished.
    fn cancel(self) -> bool => cancel_transfer(self.id);
}

@cfg(not(web))
fn cancel_transfer(id: int) -> bool => net::candela_http_cancel(id) == 1;
@cfg(web)
fn cancel_transfer(id: int) -> bool => http::candela_http_cancel(id) == 1;

/// Sends one request to `url` and answers the `Transfer`. `on_done` receives
/// the `Response`, or the reason there was none. `method` is `GET`, `POST`,
/// `PUT` and so on, either case; `headers` are sent as given; `body` is sent
/// as UTF-8 text. `timeout_ms` bounds each wait for the server, 0 waits
/// indefinitely; `max_bytes` caps the body read, 0 for the default of 64 MiB.
/// In a browser the page's `fetch` sends it, so the page's rules on other
/// origins apply.
fn request(
    url: string,
    method: string = "GET",
    headers: {string: string} = {},
    body: string = "",
    timeout_ms: int = 0,
    max_bytes: int = 0,
    on_done: fn(Response!string),
) -> Transfer {
    let read = fn(v) {
        let fields = v as {string: any};
        let heads: {string: string} = {};
        for (name, value) in fields["headers"] as {string: any} {
            heads[name] = value as string;
        }
        return Response {
            status: fields["status"] as int,
            headers: heads,
            body: fields["body"] as string,
        };
    };
    let id = event::answer(read, on_done);
    send(id, url, method, json::stringify(headers), body, timeout_ms, max_bytes);
    return Transfer { id };
}

@cfg(not(web))
fn send(id: int, url: string, method: string, headers: string, body: string, timeout_ms: int, max_bytes: int) {
    net::candela_http_request(id, url, method, headers, body, timeout_ms, max_bytes);
}
@cfg(web)
fn send(id: int, url: string, method: string, headers: string, body: string, timeout_ms: int, max_bytes: int) {
    http::candela_http_request(id, url, method, headers, body, timeout_ms, max_bytes);
}

/// Downloads `url` to `path` and answers the `Transfer`. A browser has no
/// file to download to, so there it raises `http_desktop_only`. A relative `path`
/// resolves against the base directory the host set, or the working
/// directory; missing directories on the way are created.
///
/// - `checksum`: the digest the file has to match, `sha256:<64 hex digits>`
///   or `sha1:<40 hex digits>`, or a bare digest whose length names the
///   algorithm. Empty checks nothing.
/// - `timeout_ms`: how long a quiet server is waited on, in milliseconds: for
///   the reply to start, and then for each next piece of the body. 0 waits
///   indefinitely.
/// - `max_bytes`: the largest body accepted, in bytes. 0 accepts any size.
fn download(
    url: string,
    path: string,
    checksum: string = "",
    timeout_ms: int = 0,
    max_bytes: int = 0,
    on_event: fn(Progress),
) -> Transfer {
    let id = event::source();
    event::on(id, fn(payload) {
        on_event(decode(payload));
    });
    start_download(id, url, path, checksum, timeout_ms, max_bytes);
    return Transfer { id };
}

@cfg(not(web))
fn start_download(id: int, url: string, path: string, checksum: string, timeout_ms: int, max_bytes: int) {
    net::candela_http_download(id, url, path, checksum, timeout_ms, max_bytes);
}
@cfg(web)
fn start_download(id: int, url: string, path: string, checksum: string, timeout_ms: int, max_bytes: int) {
    throw "http_desktop_only";
}

/// Caps how many transfers, requests and downloads together, run at once,
/// from 1 to 64; 4 until this is called. One started past the cap fails at
/// once. A browser keeps its own limits, so there this does nothing.
@cfg(not(web))
fn set_max_concurrent(n: int) {
    net::candela_http_set_max_concurrent(n);
}
@cfg(web)
fn set_max_concurrent(n: int) {}

/// The event a payload from the native library describes.
fn decode(payload: string) -> Progress {
    let fields = json::parse(payload).unwrap() as {string: any};
    let kind = fields["kind"] as string;
    if kind == "progress" {
        let total = fields["total"] as int;
        return Received(fields["received"] as int, if total < 0 { None } else { Some(total) });
    }
    if kind == "done" {
        return Saved(fields["path"] as string);
    }
    return Failed(fields["message"] as string);
}
