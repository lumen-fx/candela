dylib "pgo_dynlib" {
    fn pgo_add_int(a: int, b: int) -> int;
    fn pgo_add_float(a: float, b: float) -> float;
    fn pgo_all_types(a: int, b: float, c: string, d: int[], e: float[], f: string[][], g: int[][], h: int) -> int;
}

fn main() {
    print(pgo_dynlib::pgo_add_int(1,1));
    print(pgo_dynlib::pgo_add_float(1.0,1.0));
    print(pgo_dynlib::pgo_all_types(42, 42.0, "Hello, World!", [1,2,3], [1.0,2.0,3.0], [["a"], ["b"], ["c"]], [[0],[1],[2]], 2));
}